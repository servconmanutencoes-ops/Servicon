# URL pooled da branch production no Neon.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require"

# Necessaria apenas para comandos administrativos do Neon CLI.
NEON_API_KEY=""

# Neon Auth. A URL e criada por `neon deploy`; gere um segredo aleatorio com 32+ caracteres.
NEON_AUTH_BASE_URL="https://SEU-ENDPOINT.neonauth.REGIAO.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET=""

# Credenciais do cliente OAuth criado no Google Cloud (usadas para configurar o Neon Auth).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob privado. Copie os valores do painel Storage da Vercel.
BLOB_STORE_ID="store_EXEMPLO"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_EXEMPLO"
